{
  "name": "NetAlertX",
  "repo": "ghcr.io/netalertx/netalertx:latest",
  "category": [
    "network"
  ],
  "registry": "https://github.com/netalertx/NetAlertX/pkgs/container/netalertx",
  "network": "host",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --read-only --cap-drop=ALL --cap-add=NET_ADMIN --cap-add=NET_RAW --cap-add=NET_BIND_SERVICE --cap-add=CHOWN --cap-add=SETUID --cap-add=SETGID --tmpfs /tmp:uid=20211,gid=20211,mode=1700,rw,noexec,nosuid,nodev,async,noatime,nodiratime",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:20211]/",
  "readme_url": "https://docs.netalertx.com/DOCKER_INSTALLATION/",
  "icon": "https://raw.githubusercontent.com/netalertx/NetAlertX/main/front/img/NetAlertX_logo_notification.png",
  "project": "https://github.com/netalertx/NetAlertX",
  "support": "https://github.com/netalertx/NetAlertX/issues",
  "description": "NetAlertX provides network visibility, device discovery, presence monitoring and alerts for devices on your LAN.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/netalertx",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent NetAlertX configuration and database."
    }
  ],
  "ports": [],
  "variables": [
    {
      "name": "Web Port",
      "key": "PORT",
      "value": "20211",
      "mask": false,
      "description": "Port used by the NetAlertX web interface."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
