{
  "name": "Mumble Server",
  "repo": "mumblevoip/mumble-server:latest",
  "category": [
    "Network"
  ],
  "registry": "https://hub.docker.com/r/mumblevoip/mumble-server",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://github.com/dannker/mos-templates/blob/main/docs/mumble-server.md",
  "icon": "https://raw.githubusercontent.com/dannker/mos-templates/main/images/Mumble-Server.png",
  "project": "https://www.mumble.info/",
  "support": "https://github.com/mumble-voip/mumble-docker/issues",
  "description": "Official Mumble low-latency, high-quality voice chat server.",
  "paths": [
    {
      "name": "AppData",
      "host": "/mnt/cache/appdata/mumble",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Mumble database and server configuration."
    }
  ],
  "ports": [
    {
      "name": "Mumble TCP",
      "protocol": "tcp",
      "host": "64738",
      "container": "64738",
      "description": "Mumble TCP connection port."
    },
    {
      "name": "Mumble UDP",
      "protocol": "udp",
      "host": "64738",
      "container": "64738",
      "description": "Mumble UDP voice traffic."
    }
  ],
  "variables": [
    {
      "name": "User ID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "UID used by the Mumble server process. MOS recommended default: 500."
    },
    {
      "name": "Group ID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "GID used by the Mumble server process. MOS recommended default: 500."
    },
    {
      "name": "SuperUser Password",
      "key": "MUMBLE_SUPERUSER_PASSWORD",
      "value": "",
      "mask": true,
      "description": "Optional password for the Mumble SuperUser account. A random password is generated on first startup when omitted."
    },
    {
      "name": "Server Password",
      "key": "MUMBLE_CONFIG_SERVER_PASSWORD",
      "value": "",
      "mask": true,
      "description": "Optional password users must enter to connect to the server."
    },
    {
      "name": "Maximum Users",
      "key": "MUMBLE_CONFIG_USERS",
      "value": "100",
      "mask": false,
      "description": "Maximum number of simultaneous users."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
