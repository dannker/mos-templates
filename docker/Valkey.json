{
  "name": "Valkey",
  "repo": "valkey/valkey:8.0-alpine",
  "category": [
    "database",
    "tools"
  ],
  "registry": "https://hub.docker.com/r/valkey/valkey",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": "sh -c 'exec valkey-server --appendonly \"$VALKEY_APPENDONLY\" --requirepass \"$VALKEY_PASSWORD\" --maxmemory \"$VALKEY_MAXMEMORY\" --maxmemory-policy \"$VALKEY_MAXMEMORY_POLICY\"'",
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://hub.docker.com/r/valkey/valkey",
  "icon": "https://raw.githubusercontent.com/SnuK87/unraid-templates/refs/heads/main/icons/valkey-logo.png",
  "project": "https://valkey.io/",
  "support": "https://github.com/valkey-io/valkey/issues",
  "description": "Valkey is an open-source high-performance key/value datastore for caching, queues and application data.",
  "paths": [
    {
      "name": "Data",
      "host": "/mnt/cache/appdata/valkey",
      "container": "/data",
      "mode": "rw",
      "description": "Persistent Valkey data."
    }
  ],
  "ports": [
    {
      "name": "Valkey",
      "protocol": "tcp",
      "host": "6379",
      "container": "6379",
      "description": "Valkey client connection port."
    }
  ],
  "variables": [
    {
      "name": "Password",
      "key": "VALKEY_PASSWORD",
      "value": "",
      "mask": true,
      "description": "Password required by clients connecting to Valkey."
    },
    {
      "name": "Maximum Memory",
      "key": "VALKEY_MAXMEMORY",
      "value": "2gb",
      "mask": false,
      "description": "Maximum amount of memory Valkey may use."
    },
    {
      "name": "Memory Policy",
      "key": "VALKEY_MAXMEMORY_POLICY",
      "value": "noeviction",
      "mask": false,
      "description": "Eviction policy. Common values include noeviction and allkeys-lru."
    },
    {
      "name": "Append Only",
      "key": "VALKEY_APPENDONLY",
      "value": "no",
      "mask": false,
      "description": "Enable or disable append-only persistence: yes or no."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
