{
  "name": "qBittorrent",
  "repo": "qbittorrentofficial/qbittorrent-nox:latest",
  "category": [
    "Downloader"
  ],
  "registry": "https://hub.docker.com/r/qbittorrentofficial/qbittorrent-nox",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --stop-timeout 1800 --tmpfs /tmp",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "readme_url": "https://github.com/dannker/mos-templates/blob/main/docs/qbittorrent-migration.md",
  "icon": "https://raw.githubusercontent.com/dannker/mos-templates/main/images/qBittorrent.png",
  "project": "https://www.qbittorrent.org/",
  "support": "https://github.com/qbittorrent/docker-qbittorrent-nox/issues",
  "description": "Official headless qBittorrent client with WebUI.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/cache/appdata/qbittorrent",
      "container": "/config",
      "mode": "rw",
      "description": "Persistent qBittorrent configuration and session data."
    },
    {
      "name": "Downloads",
      "host": "/mnt/user/downloads",
      "container": "/downloads",
      "mode": "rw",
      "description": "Torrent download directory."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "8080",
      "container": "8080",
      "description": "qBittorrent WebUI."
    },
    {
      "name": "BitTorrent TCP",
      "protocol": "tcp",
      "host": "6881",
      "container": "6881",
      "description": "Incoming BitTorrent TCP connections."
    },
    {
      "name": "BitTorrent UDP",
      "protocol": "udp",
      "host": "6881",
      "container": "6881",
      "description": "Incoming BitTorrent UDP connections."
    }
  ],
  "variables": [
    {
      "name": "Legal Notice",
      "key": "QBT_LEGAL_NOTICE",
      "value": "",
      "mask": false,
      "description": "After reading qBittorrent's legal notice, enter confirm to acknowledge it."
    },
    {
      "name": "WebUI Port",
      "key": "QBT_WEBUI_PORT",
      "value": "8080",
      "mask": false,
      "description": "Internal qBittorrent WebUI port. The Docker port mapping must match."
    },
    {
      "name": "Torrenting Port",
      "key": "QBT_TORRENTING_PORT",
      "value": "6881",
      "mask": false,
      "description": "Internal BitTorrent listening port. TCP and UDP mappings must match."
    },
    {
      "name": "User ID",
      "key": "PUID",
      "value": "500",
      "mask": false,
      "description": "UID used by qBittorrent. MOS recommended default: 500."
    },
    {
      "name": "Group ID",
      "key": "PGID",
      "value": "500",
      "mask": false,
      "description": "GID used by qBittorrent. MOS recommended default: 500."
    },
    {
      "name": "UMASK",
      "key": "UMASK",
      "value": "022",
      "mask": false,
      "description": "Permission mask for files created by qBittorrent."
    }
  ],
  "devices": [],
  "labels": [],
  "gpus": []
}
