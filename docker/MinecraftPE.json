{
  "name": "Nukkit",
  "repo": "ixilon/nukkit:latest",
  "category": [
    "Game Server"
  ],
  "registry": "https://hub.docker.com/r/ixilon/nukkit",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "bash",
  "privileged": false,
  "extra_parameters": "-it --restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": null,
  "readme_url": "https://hub.docker.com/r/ixilon/nukkit",
  "icon": "https://raw.githubusercontent.com/dannker/mos-templates/main/images/Nukkit.png",
  "project": "https://github.com/CloudburstMC/Nukkit",
  "support": "https://gitlab.com/ixilon/nukkit-docker/-/issues",
  "description": "Nukkit is a Java-based Minecraft Bedrock Edition server with plugin support.",
  "paths": [
    {
      "name": "Server Data",
      "host": "/mnt/FAST/appdata/Nukkit",
      "container": "/srv/nukkit",
      "mode": "rw",
      "description": "Persistent Nukkit configuration, worlds, plugins and server data."
    }
  ],
  "ports": [
    {
      "name": "Minecraft Bedrock",
      "protocol": "udp",
      "host": "19132",
      "container": "19132",
      "description": "Default Minecraft Bedrock Edition server port."
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
