{
  "name": "CoolerControl",
  "repo": "coolercontrol/coolercontrold:latest",
  "category": [
    "Utilities"
  ],
  "registry": "https://hub.docker.com/r/coolercontrol/coolercontrold",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "cpu_set": null,
  "web_ui_url": "http://[IP]:[PORT:11987]/",
  "readme_url": "https://docs.coolercontrol.org/",
  "icon": "https://raw.githubusercontent.com/dannker/mos-templates/main/images/cooler-control.png",
  "project": "https://coolercontrol.org/",
  "support": "https://docs.coolercontrol.org/",
  "description": "CoolerControl is a Linux cooling control and monitoring daemon with a built-in web interface.",
  "paths": [
    {
      "name": "Config",
      "host": "/mnt/FAST/appdata/CoolerControl",
      "container": "/etc/coolercontrol",
      "mode": "rw",
      "description": "Persistent CoolerControl configuration."
    }
  ],
  "ports": [
    {
      "name": "Web UI",
      "protocol": "tcp",
      "host": "11987",
      "container": "11987",
      "description": "CoolerControl web interface."
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}
