# Docker image
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest

# Host port
APP_PORT=3000

# Library path on the host
BOOKS_HOST_PATH=/path/to/bookorbit-library

# Persistent app data
APP_DATA_PATH=/path/to/bookorbit/appdata/app

# Persistent PostgreSQL data
POSTGRES_DATA_PATH=/path/to/bookorbit/appdata/postgres

# Container UID/GID
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=bookorbit

# Application secrets
JWT_SECRET=CHANGE_ME_JWT_SECRET
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME_SETUP_TOKEN

# External/public URL
APP_URL=http://localhost:3000

# Optional client URL
CLIENT_URL=

# Node.js heap size in MB
NODE_MAX_OLD_SPACE_SIZE=2048

# Timezone
TZ=Europe/Madrid

# BookOrbit internal paths
BOOK_DOCK_PATH=/data/book-dock
LIBRARY_BROWSE_ROOT=/books

# Authentication
DISABLE_LOCAL_AUTH=false
