# Docker image
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest

# Host port
APP_PORT=3000

# BookOrbit writable library
BOOKORBIT_LIBRARY=/mnt/MEDIA/library/books/bookorbit

# Existing Calibre libraries (read-only)
CALIBRE_LIBRARY_1=/mnt/MEDIA/library/books/calibre/biblioteca
CALIBRE_LIBRARY_2=/mnt/MEDIA/library/books/calibre/calibre_1

# Persistent app data
APP_DATA_PATH=/mnt/FAST/appdata/bookorbit/app

# Persistent PostgreSQL data
POSTGRES_DATA_PATH=/mnt/FAST/appdata/bookorbit/postgres

# Container UID/GID
PUID=1000
PGID=1000

# PostgreSQL
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=bookorbit

# Application secrets
JWT_SECRET=CHANGE_ME_JWT_SECRET
PODCAST_ENCRYPTION_KEY=CHANGE_ME_PODCAST_ENCRYPTION_KEY
SETUP_BOOTSTRAP_TOKEN=CHANGE_ME_SETUP_TOKEN

# External/public URL
APP_URL=http://192.168.1.4:3000

# Optional client URL
CLIENT_URL=

# Node.js heap size in MB
NODE_MAX_OLD_SPACE_SIZE=2048

# Timezone
TZ=Europe/Madrid

# BookOrbit internal paths
BOOK_DOCK_PATH=/data/book-dock
LIBRARY_BROWSE_ROOT=/books

# Authentication
DISABLE_LOCAL_AUTH=false

# Permissions
BOOKORBIT_FIX_PERMISSIONS=true
